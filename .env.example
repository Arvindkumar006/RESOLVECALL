APP_NAME=ResolveCall
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# API Authentication (required)
# Set a strong, random secret. Operational API endpoints reject all requests
# unless this is configured. There is no default — fail closed.
RESOLVECALL_API_KEY=

# Telephony Security Whitelist
# Comma-separated E.164 phone numbers that are explicitly authorized for outbound calls.
# Wildcard (*) is NOT accepted — all destinations must be named explicitly.
# Example (documentation number — replace with your actual authorized destinations):
AUTHORIZED_PHONE_WHITELIST=+18005550100

# Telephony CLI Path
CALLE_CLI_PATH=calle

# Timeout in seconds
DEFAULT_CALL_TIMEOUT_SECONDS=300
