APP_NAME=ResolveCall
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Telephony Security Whitelist
# In production, phone calls are strictly verified against authorization policy.
# Comma-separated E.164 phone numbers or '*' to allow authorized runtime numbers
AUTHORIZED_PHONE_WHITELIST=*

# Telephony CLI Path
CALLE_CLI_PATH=calle

# Timeout in seconds
DEFAULT_CALL_TIMEOUT_SECONDS=300
