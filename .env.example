# JARVIS Sentinel - Environment Configuration
# ==========================================

# Mode Switch:
# Set to 'true' to use AWS Bedrock (requires AWS credentials)
# Set to 'false' to run in 100% offline self-contained demo mode
USE_BEDROCK=false

# AWS Bedrock Settings (Optional when USE_BEDROCK=true)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Server Settings
PORT=8000
HOST=127.0.0.1
